{
  "name": "nimiapp-overtone",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "nimi-app dev --shell electron",
    "dev:renderer": "vite --host 127.0.0.1 --port 1507 --strictPort",
    "dev:shell": "nimi-app dev",
    "dev:electron": "nimi-app dev --shell electron",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && pnpm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/bundle-electron-preload.mjs",
    "build:shell": "pnpm run build:electron",
    "test": "node --test test/*.test.mjs",
    "check": "pnpm run test && pnpm run validate",
    "pack": "nimi-app pack",
    "validate": "nimi-app check && node scripts/check-kit-first-style.mjs",
    "spec:authority:check": "nimicoding authority check .nimi/spec",
    "spec:authority:compile": "nimicoding authority compile .nimi/spec",
    "sync": "nimi-app sync",
    "build:electron:production": "node scripts/clean-electron-production.mjs && pnpm run build && node scripts/package-electron-production.mjs"
  },
  "dependencies": {
    "i18next": "^25.8.18",
    "lucide-react": "^0.577.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.5.8",
    "@nimiplatform/sdk": "^0.9.1",
    "@nimiplatform/kit": "^0.5.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^42.5.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "yaml": "^2.9.0",
    "@nimiplatform/app-tools": "^0.2.9",
    "@nimiplatform/nimi-coding": "0.6.1"
  },
  "main": "dist-electron/main.js",
  "author": "Nimi Overtone"
}
