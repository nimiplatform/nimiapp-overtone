{
  "name": "nimiapp-overtone",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "nimi-app dev --shell electron",
    "dev:renderer": "vite --host 127.0.0.1 --port 1507 --strictPort",
    "dev:shell": "nimi-app dev",
    "dev:electron": "nimi-app dev --shell electron",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/bundle-electron-preload.mjs",
    "build:shell": "tauri build",
    "test": "node --test test/*.test.mjs",
    "check": "pnpm run doctor && pnpm run test && pnpm run validate",
    "pack": "pnpm run build && node scripts/pack.mjs",
    "validate": "node scripts/validate.mjs",
    "local-audit": "node scripts/local-audit.mjs",
    "doctor": "nimi-app doctor",
    "spec:authority:check": "nimicoding authority check .nimi/spec",
    "spec:authority:compile": "nimicoding authority compile .nimi/spec"
  },
  "dependencies": {
    "@nimiplatform/sdk": "link:../../nimi/sdks/typescript",
    "@nimiplatform/kit": "link:../../nimi/kit",
    "i18next": "^25.8.18",
    "lucide-react": "^0.577.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.5.8"
  },
  "devDependencies": {
    "@nimiplatform/app-tools": "link:../../nimi/app-tools",
    "@nimiplatform/nimi-coding": "0.5.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^42.5.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "yaml": "^2.9.0"
  }
}
