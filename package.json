{
  "name": "nimiapp-overtone",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "setup:packages": "node scripts/setup-local-packages.mjs",
    "dev": "nimi-app dev --shell electron",
    "dev:renderer": "vite --host 127.0.0.1 --port 1507 --strictPort",
    "dev:shell": "nimi-app dev",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "node --test test/*.test.mjs",
    "check": "pnpm run test && pnpm run validate",
    "pack": "nimi-app pack",
    "validate": "nimi-app check && node scripts/check-kit-first-style.mjs",
    "spec:authority:check": "nimicoding authority check .nimi/spec",
    "spec:authority:compile": "nimicoding authority compile .nimi/spec",
    "sync": "nimi-app sync",
    "dev:web": "nimi-app dev --platform web",
    "dev:web-renderer": "vite --config vite.web.config.ts --mode web",
    "build:web": "pnpm run typecheck && vite build --config vite.web.config.ts --mode web",
    "build:web:release": "pnpm run typecheck && vite build --config vite.web.config.ts --mode web-release",
    "build:mobile": "pnpm run typecheck && vite build --config vite.mobile.config.ts",
    "sync:android": "pnpm run build:mobile && cap sync android",
    "dev:android": "pnpm run sync:android && cap run android --no-sync",
    "dev:mobile": "nimi-app dev --platform mobile"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "@nimiplatform/kit": "^0.24.0-rc.16",
    "@nimiplatform/sdk": "^0.24.0-rc.10",
    "@tonejs/midi": "2.0.28",
    "abcjs": "6.7.0",
    "i18next": "^26.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@nimiplatform/app-tools": "^0.16.0-rc.13",
    "@nimiplatform/nimi-coding": "0.7.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.0",
    "jsdom": "27.4.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "yaml": "^2.9.0"
  },
  "author": "Nimi Overtone",
  "license": "MIT"
}
