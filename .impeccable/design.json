    {
      "name": "Intent marker",
      "kind": "custom",
      "refersTo": "intent-field",
      "description": "Representative field and marker anatomy; the app computes its full line geometry from live intent.",
      "html": "<div class=\"ds-field\"><span class=\"ds-field-label\">Energy / surprise</span><svg class=\"ds-rules\" viewBox=\"0 0 800 300\" aria-hidden=\"true\"><path d=\"M40 150H760M400 30V270\"/></svg><button class=\"ds-point\" aria-label=\"Intent control point\"><span class=\"ds-cross\"></span></button></div>",
      "css": ".ds-field{position:relative;min-height:198px;border-radius:14px;overflow:hidden;background:var(--ot-blue, #3546df);color:#f7f8ff;font-family:var(--nimi-font-sans, sans-serif)}.ds-field-label{position:absolute;left:20px;top:17px;font-size:12px;font-weight:650}.ds-rules{width:100%;height:198px;fill:none;stroke:#bccbff;stroke-width:.6;opacity:.4}.ds-point{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:grid;place-items:center;width:30px;height:30px;min-height:30px;padding:0;border:3px solid #f6ffce;border-radius:50%;background:var(--ot-lime, #ddf594);box-shadow:0 3px 10px #0d165140;cursor:grab}.ds-point:hover{background:#eafaaf}.ds-point:active{cursor:grabbing}.ds-point:focus-visible{outline:2px solid #f6ffce;outline-offset:5px}.ds-cross{position:relative;width:8px;height:8px}.ds-cross::before,.ds-cross::after{content:\"\";position:absolute;background:#283020}.ds-cross::before{width:8px;height:1px;left:0;top:3px}.ds-cross::after{width:1px;height:8px;left:3px;top:0}"
    }
  ],
  "narrative": {
    "northStar": "The living score",
    "overview": "Musical exploration feels like a playable graphic score: off-white working surfaces, ink lettering, a saturated ultramarine intent field, and a lime marker. Flat planes and deliberate spacing support a curious, direct instrument. The Archivo Black wordmark gives it a compact, forceful signature.\n\nThis records the implemented visual system. Product authority remains under `.nimi/spec`; Kit continues to supply protected control, focus, overlay, and accessibility behavior. The approved redesign replaces the former copper/glass identity.",
    "keyCharacteristics": [
      "Flat working planes with precise dividers.",
      "Ultramarine for the intent field; lime for the movable marker and listening controls.",
      "Compact labels around generous creative content.",
      "Code geometry for intent; decoded audio for recording waveforms."
    ],
    "rules": [],
    "dos": [
      "Do use the current light/dark role tokens and keep Kit behavior intact.",
      "Do distinguish a focused interpretation, an applied direction, and a recording.",
      "Do keep labels readable and allow English and Chinese content to wrap.",
      "Do retain pointer, keyboard, and range-input access to the intent controls."
    ],
    "donts": [
      "Don't restore the replaced copper/glass identity or add ambient card shadows.",
      "Don't present the procedural score as an audio waveform or a generated recording.",
      "Don't repeat the Apply action beside the interpretation detail; the generation strip owns that next action."
    ]
  }
}
