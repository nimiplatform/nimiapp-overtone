      "description": "Large idea-entry text on a flat bordered working surface.",
      "html": "<div class=\"ds-prompt\"><textarea class=\"ds-prompt-text\" rows=\"2\" aria-label=\"Musical idea\" placeholder=\"Describe a scene or a feeling…\"></textarea></div>",
      "css": ".ds-prompt{background:var(--ot-surface, #fff);border:1px solid var(--ot-line, #dddfd5);border-radius:14px;overflow:hidden}.ds-prompt:focus-within{border-color:var(--ot-blue, #3546df)}.ds-prompt-text{width:100%;background:transparent;color:var(--ot-ink, #242621);border:0;resize:vertical;font-family:var(--nimi-font-sans, sans-serif);font-size:17px;line-height:1.6;min-height:80px;max-height:180px;padding:15px 18px 6px}.ds-prompt-text::placeholder{color:var(--ot-muted, #62665c);opacity:1}.ds-prompt-text:focus-visible{outline:2px solid var(--nimi-field-focus, #3546df);outline-offset:3px}"
    },
