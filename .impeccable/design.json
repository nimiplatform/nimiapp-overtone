      "html": "<section class=\"ds-notebook\"><h3>Sound notes</h3><p>Notes and lyrics appear here when opened.</p></section>",
      "css": ".ds-notebook{display:grid;gap:26px;padding:24px;background:var(--ot-surface, #fff);color:var(--ot-ink, #242621);border:1px solid var(--ot-line, #dddfd5);border-radius:12px;font-family:var(--nimi-font-sans, sans-serif)}.ds-notebook h3{margin:0;font-size:16px;font-weight:650}.ds-notebook p{margin:0;font-size:12px;line-height:1.8;color:var(--ot-muted, #62665c)}"
