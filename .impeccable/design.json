      "name": "Interpretation choice",
      "kind": "custom",
      "refersTo": "direction-choice",
      "description": "One focused item from the interpretation choice group; selection is distinct from applying.",
      "html": "<div class=\"ds-index\" role=\"group\" aria-label=\"Interpretations\"><button class=\"ds-choice\" aria-pressed=\"true\"><span class=\"ds-letter\">A</span><span class=\"ds-name\"><strong>Example interpretation</strong><span>Example genre</span></span></button></div>",
      "css": ".ds-choice{display:flex;gap:10px;align-items:center;width:100%;text-align:left;padding:14px 12px;min-height:69px;background:var(--ot-ink, #242621);color:var(--ot-surface, #fff);border:1px solid transparent;border-radius:10px;box-shadow:none;font-family:var(--nimi-font-sans, sans-serif)}.ds-choice:hover{background:var(--ot-ink, #242621)}.ds-choice:focus-visible{outline:2px solid var(--nimi-field-focus, #3546df);outline-offset:3px}.ds-letter{display:grid;place-items:center;width:26px;height:26px;border-radius:50%;background:var(--ot-lime, #ddf594);color:#242621;font-size:11px;font-weight:600}.ds-name{display:grid;gap:6px;min-width:0}.ds-name strong{font-size:13px;font-weight:650;line-height:1.5;overflow-wrap:anywhere}.ds-name>span{font-size:11px;line-height:1.5;opacity:.85}"
